# Existing production project; public reads use its publishable/anon key only.
# Load server values: node --env-file=.env node_modules/vite/bin/vite.js
SUPABASE_URL=https://nmjjibifcuzjlsvfcaaz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=http://localhost:8888

# Browser: same-origin Hono API only. No secrets are exposed through VITE_*.
VITE_API_BASE_URL=/api
VITE_PUBLIC_SITE_URL=https://aevicesports.com

# Public AEVIC social URLs (optional; omitted links are not rendered)
VITE_AEVIC_INSTAGRAM_URL=
VITE_AEVIC_TIKTOK_URL=
VITE_AEVIC_YOUTUBE_URL=
VITE_AEVIC_X_URL=
VITE_AEVIC_LINKEDIN_URL=
VITE_AEVIC_DISCORD_URL=
VITE_AEVIC_TWITCH_URL=
VITE_AEVIC_WEBSITE_URL=

# Allow original public Storage images through the existing CSP.
VITE_PUBLIC_MEDIA_ORIGIN=https://nmjjibifcuzjlsvfcaaz.supabase.co

# Captain BFF only: NEVER prefix these with VITE_. Existing project/objects only.
# Netlify: Production context, Functions scope only.
# Prepare the ignored import file with: node scripts/prepare-netlify-env.mjs
# This preparation does not upload values or deploy.
# Existing least-privileged PostgreSQL login, TLS required. Direct project host or Supabase pooler.
AEVIC_DATABASE_URL=
# At least 32 random characters; ADMIN_SERVER_KEY is an existing fallback.
AEVIC_SESSION_SECRET=
# Complete SMTP configuration takes precedence over Resend. All values server-only.
# EMAIL_FROM defaults to SMTP_USER. TLS is mandatory; 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=
# Existing public bucket only; code never creates buckets or changes visibility.
SUPABASE_SERVICE_ROLE_KEY=
TEAM_MEDIA_BUCKET=
